// Prisma Schema for SHAKIL GLOBAL RECRUITMENT
// Phase 1 Foundation + Phase 2 Applicant, Customer, Job & Employer Management

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. CORE AUTHENTICATION & RBAC MODELS
// ==============================================================================

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs            AuditLog[]
  notifications        Notification[]
  assignedApplicants   Applicant[]                @relation("AssignedStaff")
  createdNotes         ApplicantNote[]            @relation("NoteAuthor")
  createdJobs          Job[]                      @relation("CreatedJobs")
  assignedApplications Application[]              @relation("AssignedStaffApplication")
  uploadedDocuments    Document[]                 @relation("UploadedDocuments")
  verifiedDocuments    Document[]                 @relation("VerifiedDocuments")
  createdInterviews    Interview[]                @relation("CreatedInterviews")
  createdInvoices      Invoice[]                  @relation("CreatedInvoices")
  receivedPayments     Payment[]                  @relation("ReceivedPayments")
  refundedPayments     Refund[]                   @relation("RefundedPayments")
  statusChanges        ApplicationStatusHistory[] @relation("StatusChanger")
  createdVisaInfo      VisaInformation[]          @relation("CreatedVisaInfo")
  updatedVisaInfo      VisaInformation[]          @relation("UpdatedVisaInfo")
  assignedVisaApps     VisaApplication[]          @relation("AssignedVisaStaff")
  visaStatusChanges    VisaStatusHistory[]        @relation("VisaStatusChanger")
  createdMigrantInfo   MigrantInformation[]       @relation("CreatedMigrantInfo")
  updatedMigrantInfo   MigrantInformation[]       @relation("UpdatedMigrantInfo")
  assignedInquiries    Inquiry[]                  @relation("AssignedInquiryStaff")

  @@index([roleId])
  @@index([email])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==============================================================================
// 2. SYSTEM SETTINGS & AUDIT LOGS
// ==============================================================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  group       String   @default("system")
  description String?
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("system_settings")
}

model AuditLog {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actorType    String?    @default("STAFF") // STAFF, APPLICANT, SYSTEM
  targetUserId String?
  applicantId  String?
  applicant    Applicant? @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  action       String
  entity       String
  entityType   String?
  entityId     String?
  description  String?    @db.Text
  metadata     String?    @db.Text
  ipAddress    String?
  userAgent    String?
  oldValue     String?    @db.Text
  newValue     String?    @db.Text
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([actorUserId])
  @@index([applicantId])
  @@index([targetUserId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id          String     @id @default(uuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicantId String?
  applicant   Applicant? @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  type        String
  title       String
  message     String     @db.Text
  isRead      Boolean    @default(false)
  link        String?
  metadata    String?    @db.Text
  createdAt   DateTime   @default(now())

  @@index([userId, isRead])
  @@index([applicantId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==============================================================================
// 3. CUSTOMER RELATIONSHIP ARCHITECTURE
// ==============================================================================

model Customer {
  id           String   @id @default(uuid())
  customerType String   @default("APPLICANT") // APPLICANT, EMPLOYER, DIRECT_CLIENT
  name         String
  phone        String?
  email        String?
  applicantId  String?  @unique
  applicant    Applicant? @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  employerId   String?  @unique
  employer     Employer?  @relation(fields: [employerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices              Invoice[]
  payments              Payment[]
  financialTransactions FinancialTransaction[]
  communicationLogs     CommunicationLog[]

  @@index([customerType])
  @@map("customers")
}

// ==============================================================================
// 4. APPLICANT & CANDIDATE MODELS (PHASE 2)
// ==============================================================================

model Applicant {
  id                     String    @id @default(uuid())
  applicantNumber        String    @unique // SGR-2026-000001
  fullName               String
  fatherName             String?
  motherName             String?
  dateOfBirth            DateTime?
  gender                 String?
  phone                  String
  email                  String?
  nationality            String    @default("Bangladeshi")
  district               String?
  upazila                String?
  address                String?   @db.Text
  education              String?
  profession             String?
  yearsOfExperience      Int       @default(0)
  skills                 String?   @db.Text
  languages              String?   @db.Text
  passportAvailable      Boolean   @default(false)
  passportNumber         String?
  passportExpiry         DateTime?
  preferredCountryId     String?
  preferredCountry       Country?  @relation("PreferredCountry", fields: [preferredCountryId], references: [id], onDelete: SetNull)
  preferredJobCategoryId String?
  preferredJobCategory   JobCategory? @relation("PreferredCategory", fields: [preferredJobCategoryId], references: [id], onDelete: SetNull)
  profilePhoto           String?
  status                 String    @default("NEW") // NEW, PROFILE_INCOMPLETE, ACTIVE, SHORTLISTED, ON_HOLD, PLACED, DEPARTED, INACTIVE
  source                 String?   @default("WEBSITE") // WEBSITE, DIRECT_VISIT, REFERRAL, AGENT
  assignedStaffId        String?
  assignedStaff          User?     @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  passwordHash            String?
  isActive                Boolean   @default(true)
  isEmailVerified         Boolean   @default(false)
  isPhoneVerified         Boolean   @default(false)
  resetToken              String?
  resetTokenExpiry        DateTime?
  notificationPreferences String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  customer                Customer?
  profile                 ApplicantProfile?
  applications            Application[]
  documents               Document[]
  interviews              Interview[]
  invoices                Invoice[]
  notes                   ApplicantNote[]
  visaApplications        VisaApplication[]
  communicationLogs       CommunicationLog[]
  inquiries               Inquiry[]
  portalNotifications     Notification[]
  auditLogs               AuditLog[]

  @@index([applicantNumber])
  @@index([phone])
  @@index([status])
  @@index([preferredCountryId])
  @@index([preferredJobCategoryId])
  @@index([assignedStaffId])
  @@map("applicants")
}

model ApplicantProfile {
  id               String    @id @default(uuid())
  applicantId      String    @unique
  applicant        Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  skills           String?   @db.Text
  experienceYears  Int       @default(0)
  education        String?
  currentAddress   String?   @db.Text
  permanentAddress String?   @db.Text
  emergencyContact String?
  notes            String?   @db.Text

  @@map("applicant_profiles")
}

model ApplicantNote {
  id          String    @id @default(uuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("NoteAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  note        String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([applicantId])
  @@index([createdById])
  @@map("applicant_notes")
}

// ==============================================================================
// 5. COUNTRIES & JOB CATEGORIES (PHASE 2)
// ==============================================================================

model Country {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique // ISO 2-letter
  flag        String?  // Emoji or URL
  slug        String   @unique
  description String?  @db.Text
  continent            String?
  currency             String?
  currencyCode         String?
  timezone             String?
  recruitmentStatus    String   @default("ACTIVE") // ACTIVE, LIMITED, PAUSED, INACTIVE
  visaInformation      String?  @db.Text
  workerInformation    String?  @db.Text
  featured             Boolean  @default(false)
  displayOrder         Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  jobs                 Job[]
  employers            Employer[]
  preferredApplicants  Applicant[] @relation("PreferredCountry")
  applications         Application[]
  visaInformations     VisaInformation[]
  visaApplications     VisaApplication[]
  migrantInformations  MigrantInformation[]

  @@index([code])
  @@index([slug])
  @@index([isActive])
  @@index([recruitmentStatus])
  @@map("countries")
}

model JobCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?  // Lucide icon name
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs                Job[]
  preferredApplicants Applicant[] @relation("PreferredCategory")

  @@index([slug])
  @@index([isActive])
  @@map("job_categories")
}

// ==============================================================================
// 6. EMPLOYERS & JOBS (PHASE 2)
// ==============================================================================

model Employer {
  id                 String    @id @default(uuid())
  companyName        String
  countryId          String?
  country            Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  industry           String?
  contactPerson      String?
  email              String?
  phone              String?
  address            String?   @db.Text
  website            String?
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, INACTIVE
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer     Customer?
  jobs         Job[]
  applications Application[]

  @@index([companyName])
  @@index([verificationStatus])
  @@index([countryId])
  @@map("employers")
}

model Job {
  id                   String      @id @default(uuid())
  jobCode              String      @unique // SGR-JOB-2026-000001
  title                String
  slug                 String      @unique
  countryId            String
  country              Country     @relation(fields: [countryId], references: [id], onDelete: Restrict)
  jobCategoryId        String
  jobCategory          JobCategory @relation(fields: [jobCategoryId], references: [id], onDelete: Restrict)
  employerId           String?
  employer             Employer?   @relation(fields: [employerId], references: [id], onDelete: SetNull)
  description          String      @db.Text
  salaryMin            Decimal?    @db.Decimal(12, 2)
  salaryMax            Decimal?    @db.Decimal(12, 2)
  currency             String      @default("BDT")
  experienceRequired   Int         @default(0)
  educationRequired    String?
  ageMin               Int?
  ageMax               Int?
  languageRequirements String?
  skillsRequired       String?     @db.Text
  vacancyCount         Int         @default(1)
  accommodation        Boolean     @default(false)
  food                 Boolean     @default(false)
  transportation       Boolean     @default(false)
  medical              Boolean     @default(false)
  airTicket            Boolean     @default(false)
  workingHours         String?     // e.g. "8 hours / 6 days"
  contractDuration     String?     // e.g. "2 years renewable"
  applicationDeadline  DateTime?
  status               String      @default("DRAFT") // DRAFT, PUBLISHED, PAUSED, CLOSED, EXPIRED
  featured             Boolean     @default(false)
  createdBy            String?
  createdByUser        User?       @relation("CreatedJobs", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  applications Application[]
  interviews   Interview[]

  @@index([jobCode])
  @@index([slug])
  @@index([jobCategoryId])
  @@index([countryId])
  @@index([employerId])
  @@index([status])
  @@index([featured])
  @@map("jobs")
}

// ==============================================================================
// 7. APPLICATIONS, RECRUITMENT OPERATIONS & PIPELINE (PHASE 3)
// ==============================================================================

model Application {
  id                String      @id @default(uuid())
  applicationCode   String      @unique // SGR-APP-2026-000001
  applicationNumber String?     @unique // SGR-APP-2026-000001 alias
  applicantId       String
  applicant         Applicant   @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  jobId             String
  job               Job         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  employerId        String?
  employer          Employer?   @relation(fields: [employerId], references: [id], onDelete: SetNull)
  countryId         String?
  country           Country?    @relation(fields: [countryId], references: [id], onDelete: SetNull)
  currentStage      String      @default("NEW")
  status            String      @default("NEW") // Controlled recruitment pipeline
  appliedAt         DateTime    @default(now())
  source            String?     @default("DIRECT_VISIT")
  assignedStaffId   String?
  assignedStaff     User?       @relation("AssignedStaffApplication", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  priority          String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  notes             String?     @db.Text
  rejectionReason   String?     @db.Text
  selectedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  statusHistory   ApplicationStatusHistory[]
  documents       Document[]
  interviews      Interview[]
  visaApplications VisaApplication[]
  invoices        Invoice[]

  @@index([applicantId])
  @@index([jobId])
  @@index([employerId])
  @@index([countryId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([currentStage])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     String?
  toStage       String
  changedById   String?
  changedBy     User?       @relation("StatusChanger", fields: [changedById], references: [id], onDelete: SetNull)
  reason        String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@index([changedById])
  @@map("application_status_history")
}

model DocumentType {
  id                   String   @id @default(uuid())
  name                 String   @unique
  code                 String   @unique // PASSPORT, NID, CV, etc.
  description          String?  @db.Text
  isRequired           Boolean  @default(false)
  requiresExpiry       Boolean  @default(false)
  applicableCountryId  String?
  applicableCategoryId String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  documents Document[]

  @@index([code])
  @@index([isActive])
  @@map("document_types")
}

model Document {
  id              String       @id @default(uuid())
  applicantId     String
  applicant       Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicationId   String?
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  documentTypeId  String
  documentType    DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  fileName        String
  filePath        String
  fileUrl         String?
  fileSize        Int
  mimeType        String
  version         Int          @default(1)
  isLatest        Boolean      @default(true)
  status          String       @default("UPLOADED") // UPLOADED, UNDER_REVIEW, VERIFIED, REJECTED, EXPIRED
  uploadedById    String?
  uploadedBy      User?        @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedById    String?
  verifiedBy      User?        @relation("VerifiedDocuments", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  rejectionReason String?      @db.Text
  expiryDate      DateTime?
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([applicantId])
  @@index([applicationId])
  @@index([documentTypeId])
  @@index([status])
  @@map("documents")
}

model Interview {
  id               String      @id @default(uuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicantId      String
  applicant        Applicant   @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobId            String
  job              Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviewType    String      @default("AGENCY") // EMPLOYER, AGENCY, ONLINE, PHONE, VIDEO, IN_PERSON
  scheduledAt      DateTime
  durationMinutes  Int         @default(30)
  location         String?
  meetingLink      String?
  interviewer      String?
  status           String      @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, PASSED, FAILED, RESCHEDULED, CANCELLED, NO_SHOW
  result           String?
  score            Int?
  feedback         String?     @db.Text
  notes            String?     @db.Text
  createdById      String?
  createdBy        User?       @relation("CreatedInterviews", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([applicationId])
  @@index([applicantId])
  @@index([jobId])
  @@index([status])
  @@map("interviews")
}

// ==============================================================================
// 8. FINANCIAL ACCOUNTING, INVOICES, PAYMENTS & LEDGER (PHASE 4)
// ==============================================================================

model Service {
  id           String   @id @default(uuid())
  serviceName  String
  serviceCode  String   @unique // REC-001, VISA-001, etc.
  description  String?  @db.Text
  defaultPrice Decimal  @db.Decimal(12, 2)
  currency     String   @default("BDT")
  taxRate      Decimal  @default(0) @db.Decimal(5, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoiceItems InvoiceItem[]

  @@index([serviceCode])
  @@index([isActive])
  @@map("services")
}

model Invoice {
  id            String       @id @default(uuid())
  invoiceNumber String       @unique // SGR-INV-2026-000001
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  applicantId   String?
  applicant     Applicant?   @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  invoiceDate   DateTime     @default(now())
  dueDate       DateTime?
  currency      String       @default("BDT")
  subtotal      Decimal      @default(0) @db.Decimal(12, 2)
  discount      Decimal      @default(0) @db.Decimal(12, 2)
  tax           Decimal      @default(0) @db.Decimal(12, 2)
  adjustment    Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal      @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal      @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal      @default(0) @db.Decimal(12, 2)
  status        String       @default("DRAFT") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, OVERDUE, VOID, CANCELLED, REFUNDED
  notes         String?      @db.Text
  terms         String?      @db.Text
  createdById   String?
  createdBy     User?        @relation("CreatedInvoices", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items                 InvoiceItem[]
  payments              Payment[]
  refunds               Refund[]
  adjustments           FinancialAdjustment[]
  financialTransactions FinancialTransaction[]

  @@index([customerId])
  @@index([applicantId])
  @@index([applicationId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceCode String?
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@index([serviceId])
  @@map("invoice_items")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("payment_methods")
}

model Payment {
  id              String    @id @default(uuid())
  paymentNumber   String    @unique // SGR-PAY-2026-000001
  receiptNumber   String?   @unique // SGR-RCP-2026-000001
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("BDT")
  paymentDate     DateTime  @default(now())
  paymentMethod   String    @default("CASH") // CASH, BANK_TRANSFER, MOBILE_BANKING, CARD, CHEQUE, OTHER
  referenceNumber String?
  transactionId   String?
  receivedById    String?
  receivedBy      User?     @relation("ReceivedPayments", fields: [receivedById], references: [id], onDelete: SetNull)
  status          String    @default("COMPLETED") // COMPLETED, REVERSED, VOID
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refunds               Refund[]
  financialTransactions FinancialTransaction[]

  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentNumber])
  @@index([paymentDate])
  @@map("payments")
}

model Refund {
  id           String    @id @default(uuid())
  refundNumber String    @unique // SGR-REF-2026-000001
  invoiceId    String
  invoice      Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentId    String?
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount       Decimal   @db.Decimal(12, 2)
  reason       String    @db.Text
  refundMethod String    @default("CASH")
  refundedById String?
  refundedBy   User?     @relation("RefundedPayments", fields: [refundedById], references: [id], onDelete: SetNull)
  refundDate   DateTime  @default(now())
  status       String    @default("COMPLETED") // PENDING, APPROVED, COMPLETED, REJECTED
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())

  financialTransactions FinancialTransaction[]

  @@index([invoiceId])
  @@index([paymentId])
  @@index([refundNumber])
  @@map("refunds")
}

model FinancialAdjustment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        String   // DISCOUNT_CORRECTION, ROUNDING, CREDIT, DEBIT
  amount      Decimal  @db.Decimal(12, 2)
  reason      String   @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("financial_adjustments")
}

model FinancialTransaction {
  id              String    @id @default(uuid())
  transactionType String    // INVOICE, PAYMENT, REFUND, ADJUSTMENT, VOID
  referenceNumber String
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  applicantId     String?
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId       String?
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refundId        String?
  refund          Refund?   @relation(fields: [refundId], references: [id], onDelete: SetNull)
  debit           Decimal   @default(0) @db.Decimal(12, 2)
  credit          Decimal   @default(0) @db.Decimal(12, 2)
  balance         Decimal   @default(0) @db.Decimal(12, 2)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([customerId])
  @@index([invoiceId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("financial_transactions")
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?   @db.Text
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("blog_posts")
}

model MigrantInformation {
  id                String    @id @default(uuid())
  country           String?
  title             String
  category          String    // BEFORE_TRAVEL, RECRUITMENT, VISA, DOCUMENTS, AIRPORT, ARRIVAL, WORKPLACE, WORKER_RIGHTS, SALARY, CONTRACT, SAFETY, SCAM_AWARENESS, EMERGENCY, RETURN
  slug              String    @unique
  summary           String?   @db.Text
  content           String    @db.Text
  featuredImage     String?
  countryId         String?
  countryRef        Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  officialSource    String?
  officialSourceUrl String?
  lastVerifiedAt    DateTime?
  status            String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  isPublished       Boolean   @default(true)
  publishedAt       DateTime? @default(now())
  createdById       String?
  createdBy         User?     @relation("CreatedMigrantInfo", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       String?
  updatedBy         User?     @relation("UpdatedMigrantInfo", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([category])
  @@index([status])
  @@index([slug])
  @@map("migrant_information")
}

// ==============================================================================
// 10. VISA & IMMIGRATION SYSTEM (PHASE 5)
// ==============================================================================

model VisaInformation {
  id                    String    @id @default(uuid())
  countryId             String
  country               Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  visaType              String    // WORK_VISA, EMPLOYMENT_VISA, WORK_PERMIT, SKILLED_WORK_VISA, TEMPORARY_WORK_VISA, SEASONAL_WORK_VISA, OTHER
  title                 String
  slug                  String    @unique
  overview              String?   @db.Text
  eligibility           String?   @db.Text
  requiredDocuments     String?   @db.Text
  applicationProcess    String?   @db.Text
  processingInformation String?   @db.Text
  feesInformation       String?   @db.Text
  validityInformation   String?   @db.Text
  workRights            String?   @db.Text
  restrictions          String?   @db.Text
  officialSourceName    String?
  officialSourceUrl     String?
  lastVerifiedAt        DateTime?
  isActive              Boolean   @default(true)
  createdById           String?
  createdBy             User?     @relation("CreatedVisaInfo", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById           String?
  updatedBy             User?     @relation("UpdatedVisaInfo", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([countryId])
  @@index([visaType])
  @@index([slug])
  @@index([isActive])
  @@map("visa_information")
}

model VisaApplication {
  id                    String               @id @default(uuid())
  visaApplicationNumber String               @unique // SGR-VISA-2026-000001
  applicationId         String
  application           Application          @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicantId           String
  applicant             Applicant            @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  countryId             String
  country               Country              @relation(fields: [countryId], references: [id], onDelete: Restrict)
  visaType              String               @default("WORK_VISA")
  status                String               @default("NOT_STARTED") // NOT_STARTED, DOCUMENT_PENDING, DOCUMENT_READY, SUBMITTED, UNDER_REVIEW, BIOMETRICS, MEDICAL, ADDITIONAL_DOCUMENT_REQUESTED, INTERVIEW, APPROVED, REJECTED, WITHDRAWN, EXPIRED, COMPLETED
  submissionDate        DateTime?
  appointmentDate       DateTime?
  biometricsDate        DateTime?
  medicalDate           DateTime?
  decisionDate          DateTime?
  visaExpiryDate        DateTime?
  referenceNumber       String?
  rejectionReason       String?              @db.Text
  notes                 String?              @db.Text
  assignedStaffId       String?
  assignedStaff         User?                @relation("AssignedVisaStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  statusHistory         VisaStatusHistory[]
  appointments          VisaAppointment[]

  @@index([applicationId])
  @@index([applicantId])
  @@index([countryId])
  @@index([visaApplicationNumber])
  @@index([status])
  @@index([assignedStaffId])
  @@map("visa_applications")
}

model VisaStatusHistory {
  id                String          @id @default(uuid())
  visaApplicationId String
  visaApplication   VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)
  oldStatus         String?
  newStatus         String
  changedById       String?
  changedBy         User?           @relation("VisaStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)
  reason            String?
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())

  @@index([visaApplicationId])
  @@index([changedById])
  @@map("visa_status_history")
}

model VisaAppointment {
  id                String          @id @default(uuid())
  visaApplicationId String
  visaApplication   VisaApplication @relation(fields: [visaApplicationId], references: [id], onDelete: Cascade)
  appointmentType   String          // BIOMETRICS, EMBASSY, MEDICAL, INTERVIEW
  appointmentDate   DateTime
  location          String?
  reference         String?
  status            String          @default("SCHEDULED") // SCHEDULED, ATTENDED, CANCELLED, RESCHEDULED
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())

  @@index([visaApplicationId])
  @@index([appointmentType])
  @@index([appointmentDate])
  @@map("visa_appointments")
}

// ==============================================================================
// 11. COMMUNICATIONS & LEADS (PHASE 6)
// ==============================================================================

model CommunicationTemplate {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  channel   String   // IN_APP, EMAIL, SMS, WHATSAPP
  subject   String?
  content   String   @db.Text
  variables String?  // comma-separated keys e.g. "applicantName,applicationNumber"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs      CommunicationLog[]

  @@index([code])
  @@index([channel])
  @@map("communication_templates")
}

model CommunicationLog {
  id                String                 @id @default(uuid())
  customerId        String?
  customer          Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  applicantId       String?
  applicant         Applicant?             @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  channel           String                 // IN_APP, EMAIL, SMS, WHATSAPP
  templateId        String?
  template          CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipient         String
  subject           String?
  message           String                 @db.Text
  status            String                 @default("SENT") // QUEUED, SENT, DELIVERED, FAILED, READ
  providerMessageId String?
  failureReason     String?                @db.Text
  retryCount        Int                    @default(0)
  sentAt            DateTime?              @default(now())
  createdAt         DateTime               @default(now())

  @@index([channel])
  @@index([status])
  @@index([applicantId])
  @@index([recipient])
  @@index([createdAt])
  @@map("communication_logs")
}

model Inquiry {
  id                   String     @id @default(uuid())
  inquiryNumber        String     @unique // SGR-INQ-2026-000001
  name                 String
  phone                String
  email                String?
  subject              String
  message              String     @db.Text
  source               String     @default("WEBSITE_CONTACT")
  status               String     @default("NEW") // NEW, CONTACTED, FOLLOW_UP, CONVERTED, CLOSED
  notes                String?    @db.Text
  convertedApplicantId String?
  convertedApplicant   Applicant? @relation(fields: [convertedApplicantId], references: [id], onDelete: SetNull)
  assignedStaffId      String?
  assignedStaff        User?      @relation("AssignedInquiryStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([status])
  @@index([phone])
  @@index([assignedStaffId])
  @@index([createdAt])
  @@map("inquiries")
}
