# ==============================================================================
# SHAKIL GLOBAL RECRUITMENT — LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env for local development
# ==============================================================================

# Node Environment & Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection String (Required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shakil_global_recruitment?schema=public"

# Authentication & Session Security (Required)
# Staff internal session secret (minimum 32 characters, recommended 64-char hex)
AUTH_SECRET="dev_staff_secret_replace_with_64_char_hex_for_production"
JWT_SECRET="dev_staff_secret_replace_with_64_char_hex_for_production"
COOKIE_NAME="sgr_session"

# Candidate portal session secret (must be distinct from staff secret)
PORTAL_JWT_SECRET="dev_portal_secret_replace_with_64_char_hex_for_production"

# Email Service (Optional for local dev, uses MOCK logger if unconfigured)
EMAIL_PROVIDER="MOCK" # Options: SMTP, RESEND, SENDGRID, MOCK
EMAIL_API_KEY=""
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Shakil Global Recruitment <no-reply@shakilglobal.com>"

# SMS Gateway (Optional for local dev, uses MOCK logger if unconfigured)
SMS_PROVIDER="MOCK" # Options: TWILIO, SSL_WIRELESS, BANGLALINK, MOCK
SMS_API_KEY=""
SMS_SENDER_ID="SHAKILGLB"

# Official WhatsApp Business API (Optional for local dev, uses MOCK logger if unconfigured)
WHATSAPP_PROVIDER="MOCK" # Options: META_CLOUD_API, TWILIO, MOCK
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Payment Gateway Configuration (Manual counter/bank transfer active by default)
PAYMENT_PROVIDER="MANUAL" # Options: MANUAL, BKASH, SSLCOMMERZ
PAYMENT_API_KEY=""

# Document File Storage (LOCAL for development, S3 for cloud)
STORAGE_PROVIDER="LOCAL" # Options: LOCAL, S3
STORAGE_DIR="uploads/private"
# Cloud Storage (Required if STORAGE_PROVIDER="S3")
STORAGE_ENDPOINT="" # Optional custom endpoint (e.g., https://<account_id>.r2.cloudflarestorage.com or http://localhost:9000 for MinIO)
STORAGE_REGION="us-east-1"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ALLOW_LOCAL_IN_PRODUCTION="false"
