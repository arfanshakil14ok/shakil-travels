# ==============================================================================
# SHAKIL GLOBAL RECRUITMENT — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Copy this file to .env.production on your production server.
# NEVER commit real production secrets to git or version control.
# ==============================================================================

# Node Environment & Server (Required)
NODE_ENV=production
PORT=3000
APP_URL=https://shakilglobal.com
NEXT_PUBLIC_APP_URL=https://shakilglobal.com

# PostgreSQL Database Connection String (Required)
# Use connection pooling / pgbouncer in high-traffic production environments
DATABASE_URL="postgresql://shakil_db_user:YOUR_STRONG_DATABASE_PASSWORD@postgres.internal.shakilglobal.com:5432/shakil_global_recruitment?schema=public&sslmode=require"

# Cryptographic Authentication Secrets (Required)
# Generate distinct 64-character random hex keys (e.g. using: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
AUTH_SECRET="REPLACE_WITH_UNIQUE_64_CHAR_RANDOM_HEX_FOR_INTERNAL_STAFF_AUTH"
JWT_SECRET="REPLACE_WITH_UNIQUE_64_CHAR_RANDOM_HEX_FOR_INTERNAL_STAFF_AUTH"
COOKIE_NAME="sgr_session"

# Candidate Portal Session Secret (Required - MUST be different from AUTH_SECRET)
PORTAL_JWT_SECRET="REPLACE_WITH_UNIQUE_64_CHAR_RANDOM_HEX_FOR_CANDIDATE_PORTAL_AUTH"

# Transactional Email Service (Required for notifications, reset password, invoices)
# Options: SMTP, RESEND, SENDGRID (MOCK is strictly blocked in production)
EMAIL_PROVIDER="SMTP"
EMAIL_API_KEY="" # Required if using RESEND or SENDGRID
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@mg.shakilglobal.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="Shakil Global Recruitment <no-reply@shakilglobal.com>"

# Transactional SMS Gateway (Required for candidate SMS alerts)
# Options: SSL_WIRELESS, TWILIO, BANGLALINK
SMS_PROVIDER="SSL_WIRELESS"
SMS_API_KEY="YOUR_OFFICIAL_SMS_GATEWAY_API_KEY"
SMS_SENDER_ID="SHAKILGLB"

# Official WhatsApp Business API (Required for candidate WhatsApp alerts)
# Options: META_CLOUD_API, TWILIO
WHATSAPP_PROVIDER="META_CLOUD_API"
WHATSAPP_API_KEY="YOUR_META_WHATSAPP_SYSTEM_USER_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_META_REGISTERED_PHONE_NUMBER_ID"

# Payment Accounting Gateway
# MANUAL is default production mode with administrative counter/bank/receipt logging.
# If connecting online gateway (e.g. bKash / SSLCommerz), set provider & credentials below.
PAYMENT_PROVIDER="MANUAL" # Options: MANUAL, BKASH, SSLCOMMERZ
PAYMENT_API_KEY=""

# Document File Storage (S3-compatible Cloud Storage is primary for production)
# Supports AWS S3, Cloudflare R2, MinIO, Wasabi, DigitalOcean Spaces
STORAGE_PROVIDER="S3" # Options: S3, LOCAL (Requires STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true if LOCAL)
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="shakil-global-documents-prod"
STORAGE_ACCESS_KEY="YOUR_PRODUCTION_S3_ACCESS_KEY_ID"
STORAGE_SECRET_KEY="YOUR_PRODUCTION_S3_SECRET_ACCESS_KEY"
STORAGE_ENDPOINT="" # Optional custom endpoint (leave blank for standard AWS S3)
STORAGE_ALLOW_LOCAL_IN_PRODUCTION="false" # Set true ONLY if deploying on a single persistent VM with mounted volume
